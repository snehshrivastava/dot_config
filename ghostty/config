# theme — matches the tokyonight-night palette already used in nvim,
# so terminal and editor look like one continuous surface
theme = "TokyoNight Night"

# font
font-family = "JetBrainsMono Nerd Font"
font-size = 13

# macOS CoreText renders text thin/blurry on non-Retina and external
# monitors; thicken compensates (strength tuned down from default 255
# so it doesn't overcorrect on the built-in Retina panel)
font-thicken = true
font-thicken-strength = 150

# avoids washed-out/hazy color blending on some macOS displays
window-colorspace = "display-p3"

# terminfo Ghostty reports — tmux inside will still use tmux-256color, this is fine
term = xterm-ghostty

# mouse: ghostty forwards SGR mouse events to tmux/nvim natively, no opt-in
# checkbox needed (unlike iTerm2's "Enable mouse reporting")
mouse-hide-while-typing = true
mouse-scroll-multiplier = 3

# over SSH, a remote tmux/vim/pager often captures mouse-reporting, so a
# plain click-drag gets forwarded to it and its redraw snaps the view to
# the bottom instead of just selecting text; "never" locks shift+drag to
# always do local selection regardless of what the remote app requests —
# hold shift while selecting on remote sessions
mouse-shift-capture = never

scrollback-limit = 10000

# true color
window-decoration = true

# macOS doesn't send the escape sequences zsh needs for option+arrow
# word-jump / option+delete unless the terminal opts in
macos-option-as-alt = true

# breathing room around text, and a cursor that doesn't blink-flicker
window-padding-x = 10
window-padding-y = 8
cursor-style = block
cursor-style-blink = false

# subtle depth without hurting text contrast (macOS only)
background-opacity = 0.96
background-blur-radius = 20
