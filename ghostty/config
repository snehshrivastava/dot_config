# font
font-family = "JetBrainsMono Nerd Font"
font-size = 13

# macOS CoreText renders text thin/blurry on non-Retina and external
# monitors; thicken compensates (strength tuned down from default 255
# so it doesn't overcorrect on the built-in Retina panel)
font-thicken = true
font-thicken-strength = 150

# avoids washed-out/hazy color blending on some macOS displays
window-colorspace = "display-p3"

# terminfo Ghostty reports — tmux inside will still use tmux-256color, this is fine
term = xterm-ghostty

# mouse: ghostty forwards SGR mouse events to tmux/nvim natively, no opt-in
# checkbox needed (unlike iTerm2's "Enable mouse reporting")
mouse-hide-while-typing = true
mouse-scroll-multiplier = 3
mouse-shift-capture = false

scrollback-limit = 10000

# true color
window-decoration = true
